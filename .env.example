# Copy to the host (e.g. /etc/orca-mcp/env or ~/.orca-bridge/env), chmod 600.
# Never commit real values.
#
# Required for both transports (HTTP default and `orca-mcp --stdio`).

ORCA_BRIDGE_TOKEN=replace-with-openssl-rand-hex-32

# HTTP / OAuth only (unused in --stdio mode)
ORCA_BRIDGE_PUBLIC_ORIGIN=https://your-host.example.ts.net

# Optional (both transports unless noted)
# ORCA_CLI_COMMAND=orca
# ORCA_CLI_COMMAND=orca-ide
# ORCA_BRIDGE_DEFAULT_REPO=path:/path/to/repo
# ORCA_BRIDGE_DEFAULT_AGENT=omp
# ORCA_BRIDGE_REDIRECT_ALLOW=https://hyperagent.com/,https://claude.ai/   # HTTP OAuth only
# HINDSIGHT_URL=http://127.0.0.1:8888                                    # HTTP proxy only
# PORT=8787                                                              # HTTP only
# ORCA_BRIDGE_DEBUG=0                                                    # mute access log
#
# Capability toolsets (default = all enabled: status,dispatch,admin)
# ORCA_BRIDGE_TOOLSETS=status,dispatch   # supervised coordinators, no admin cli
# ORCA_BRIDGE_TOOLSETS=status            # read-only observer
#   equivalent CLI flag: node server.mjs --read-only  (--read-only wins over env)
#
# CLI exact-form allowlist (default ON / NAS-227). Explicit off for migration only:
# ORCA_BRIDGE_CLI_HARDENING=0   # warn-only; do not use on shared hosts
# ORCA_BRIDGE_CLI_ADMIN=1       # union admin toolset (compat; ignored under --read-only)
# Optional: append-only audit log directory (default ~/.orca-bridge)
# ORCA_BRIDGE_AUDIT_DIR=/var/lib/orca-bridge
