[Unit]
Description=orca-mcp — external MCP server for Orca
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Dedicated service account. Every user-ish setting below must agree with these
# two lines: the bridge's state (OAuth tokens, sender pins, audit log) is written
# into this account's HOME and must stay owned by it. See README § Linux.
User=orca
Group=orca
# Any directory the service account can read — state does NOT go here.
WorkingDirectory=/opt/orca-mcp
# MUST be the home of User= above (replace `orca` if you renamed the account).
# If HOME belongs to a different account, the bridge writes tokens somewhere it
# may not own and clients re-authorize after every restart.
Environment=HOME=/home/orca
Environment=PATH=/home/orca/.local/bin:/usr/local/bin:/usr/bin:/bin
# Plain KEY=VALUE env file (mode 600). Token/origin stay on the host, not in git.
EnvironmentFile=/etc/orca-mcp/env
# NAS-255 (opt-in worker uid): merge deploy/linux worker-isolation.env fragment
# after install-worker-uid.sh. Bridge stays User=orca; agents run as orca-worker
# via ORCA_BRIDGE_WORKER_LAUNCH_WRAPPER. Do NOT add the worker to a shared group
# with this account — that re-opens the secret class. Per-dispatch uid is NOT
# shipped. See docs/runbooks/nas-255-worker-uid.md.
# Long-running node directly — not run.sh/nohup (those exit after start).
# Checkout install (repo owned by the service account):
ExecStart=/usr/bin/node /opt/orca-mcp/server.mjs --port 8787
# Global npm install instead? Swap the line above for:
#   ExecStart=/usr/bin/orca-mcp --port 8787
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orca-bridge
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
